<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lsm.wifi</string>

    <!-- Wi-Fi RSSI logger (2026-11-04): one system_profiler scan every 5 min,
         strongest radios appended to wifi_rssi.csv. One-shot per tick, not KeepAlive. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/proofsandreasons/monitor/wifi_log.py</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/proofsandreasons/monitor</string>
    <key>StandardOutPath</key>
    <string>/Users/proofsandreasons/monitor/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/proofsandreasons/monitor/launchd.err.log</string>
</dict>
</plist>
